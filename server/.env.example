# Copy to server/.env and fill in. Nothing here is required to run locally:
# without SMTP the enquiry endpoint logs submissions instead of emailing them.

NODE_ENV=development
PORT=8787

# Comma-separated browser origins allowed to call the API.
# Leave empty in development (the Vite dev server proxies /api).
CORS_ORIGINS=

# Serve the built client from this process too (single-box deploy).
SERVE_CLIENT=false
CLIENT_DIR=../client/dist

# Per-IP submission limit.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5

# SMTP — any provider works (Gmail app password, Resend, Postmark, Mailgun…).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=
